<?xml version="1.0"?>
<ruleset name="GT Page Blocks Builder">
	<description>Coding standards for GT Page Blocks Builder.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/__release-*/*</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- The plugin predates the class-file naming convention and renaming
		     files would break every require path for no benefit. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Yoda conditions are not this codebase's style. -->
		<exclude name="WordPress.PHP.YodaConditions"/>
	</rule>

	<!-- The i18n sweep depends on this: it is what makes the 82 strings still
	     carrying the retired 'md' domain a machine-checkable failure rather
	     than a manual grep. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="page-blocks-builder"/>
			</property>
		</properties>
	</rule>
</ruleset>
