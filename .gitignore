/.DS_Store
assets/.DS_Store
*.DS_Store*
assets/.DS_Store

# Composer artifacts. The tooling *config* is tracked, so a fresh clone can
# run the same analysis CI does; only the installed tree is ignored.
vendor/

# Per-release operational scripts. They are run once against the live store
# and never packaged (the release workflow copies an allowlist), so they are
# working files rather than source. Write them here if you like; git will not
# carry them.
__release-*/
